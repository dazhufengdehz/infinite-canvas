{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "无限画布",
    "version": "0.25.4",
    "identifier": "com.imihoo.infinite-canvas",
    "build": {
        "beforeDevCommand": { "script": "bun run dev", "cwd": ".." },
        "beforeBuildCommand": { "script": "bun run build", "cwd": ".." },
        "devUrl": "http://localhost:3000",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "无限画布",
                "width": 1440,
                "height": 960,
                "minWidth": 960,
                "minHeight": 640,
                "dragDropEnabled": false
            }
        ]
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["infinite-canvas"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "windows": {
            "wix": {
                "language": "zh-CN"
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": ["binaries/node"],
        "resources": {
            "../server/desktop-server.mjs": "server/desktop-server.mjs",
            "../server/storage-files.mjs": "server/storage-files.mjs",
            "resources/canvas-agent": "canvas-agent"
        }
    }
}
